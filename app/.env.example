# Postgres (Railway, volume-backed)
DATABASE_URL=postgresql://user:pass@host:5432/clipmind

# Minds Builder API (server-side only, never in client/build)
MINDS_BUILDER_API_KEY=

# Clip service (token-gated)
CLIP_SERVICE_URL=http://localhost:8000
CLIP_SERVICE_TOKEN=

# Cloudflare R2 storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SOURCES_BUCKET=
R2_MEDIA_BUCKET=
R2_MEDIA_PUBLIC_BASE=

# OpenAI (if captions/whisper are called from the backend)
OPENAI_API_KEY=

# FCM web push
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
CRON_SECRET=
NEXT_PUBLIC_FCM_API_KEY=
NEXT_PUBLIC_FCM_SENDER_ID=
NEXT_PUBLIC_FCM_APP_ID=
NEXT_PUBLIC_FCM_PROJECT_ID=
NEXT_PUBLIC_FCM_VAPID_KEY=
