# Postgres (Railway, volume-backed)
DATABASE_URL=postgresql://user:pass@host:5432/clipmind

# Minds Builder API (server-side only, never in client/build)
MINDS_BUILDER_API_KEY=

# Clip service (token-gated)
CLIP_SERVICE_URL=http://localhost:8000
CLIP_SERVICE_TOKEN=

# OpenAI (if captions/whisper are called from the backend)
OPENAI_API_KEY=

# FCM web push
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
