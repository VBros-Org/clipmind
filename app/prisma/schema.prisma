// ClipMind data model. Owned by the TypeScript backend (the only DB owner).
// See docs/build-plan.md section 11. State machine lives on Clip.status.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Creator {
  id                String             @id @default(cuid())
  accessCode        String?            @unique
  displayName       String?
  channelUrl        String?
  mindId            String? // the creator's Minds agent (voice + clip-taste Tenets)
  mindStage         String? // pending | learning_voice | waking_mind | teaching_taste | ready | failed
  mindError         String? // Short named-step Mind onboarding failure message. Never stores stack traces.
  initialTenets     Json? // distilled creator voice + clip-taste Tenets from onboarding
  captionCorpus     String? // creator-pasted recent post-copy captions, one per line
  captionStyle      Json? // burned-in subtitle preset: font, size, position, colour, highlight
  createdAt         DateTime           @default(now())
  inviteCode        InviteCode?
  videos            Video[]
  clips             Clip[]
  schedule          Schedule?
  pushSubscriptions PushSubscription[]
  nudgeLogs         NudgeLog[]
}

model InviteCode {
  id              String    @id @default(cuid())
  code            String    @unique
  note            String?
  usedByCreatorId String?   @unique
  usedByCreator   Creator?  @relation(fields: [usedByCreatorId], references: [id])
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
}

model Video {
  id            String   @id @default(cuid())
  creatorId     String
  creator       Creator  @relation(fields: [creatorId], references: [id])
  sourceUrl     String?
  sourceKey     String?
  contentKey    String?  @unique
  status        String   @default("uploaded") // uploaded | transcribed | clipped
  pipelineStage String? // uploaded | transcribing | candidates | ranking | captions | done | failed
  pipelineError String?
  createdAt     DateTime @default(now())
  clips         Clip[]
}

enum ClipStatus {
  candidate
  accepted
  rejected
  scheduled
  posted
}

model Clip {
  id               String     @id @default(cuid())
  videoId          String
  video            Video      @relation(fields: [videoId], references: [id])
  creatorId        String
  creator          Creator    @relation(fields: [creatorId], references: [id])
  startMs          Int
  endMs            Int
  trimStartMs      Int? // in-app top/tail trim
  trimEndMs        Int?
  renderedUrl      String? // clip with baked-in subtitles
  thumbKey         String? // media bucket key for static JPEG poster
  postCopy         String? // legacy default post-copy; mirrors postCopyVariants.tiktok
  postCopyVariants Json? // post-copy variants: { youtube, tiktok, instagram }
  transcript       String?
  reasons          Json?
  mindRank         Int? // Mind ranking metadata only, 1 = best
  mindRankReason   String?
  rejectReason     String? // optional creator reason for rejected clips
  status           ClipStatus @default(candidate)
  scheduledFor     DateTime?
  postedAt         DateTime?
  feedbackSyncedAt DateTime?
  createdAt        DateTime   @default(now())
}

model Schedule {
  id                  String    @id @default(cuid())
  creatorId           String    @unique
  creator             Creator   @relation(fields: [creatorId], references: [id])
  slots               Json // post times
  rotation            Json // deterministic rotation state (least-recently-served)
  slotsPerDay         Int       @default(1)
  anchorHour          Int       @default(9)
  reviewReminders     Boolean   @default(true)
  runwayWarnings      Boolean   @default(true)
  runwayThresholdDays Int       @default(2)
  postTimeNudges      Boolean   @default(true)
  pushNudges          Boolean   @default(false)
  lastScheduledAt     DateTime?
  updatedAt           DateTime  @updatedAt
}

model LearningEvent {
  id        String   @id @default(cuid())
  clipId    String
  creatorId String
  action    String // accept | reject (feeds the Mind's taste)
  createdAt DateTime @default(now())
}

model PushSubscription {
  id         String    @id @default(cuid())
  creatorId  String
  creator    Creator   @relation(fields: [creatorId], references: [id])
  token      String    @unique
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  disabledAt DateTime?

  @@index([creatorId, disabledAt])
}

model NudgeLog {
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id])
  kind      String
  dedupeKey String
  sentAt    DateTime @default(now())

  @@id([creatorId, kind, dedupeKey])
  @@index([sentAt])
}
